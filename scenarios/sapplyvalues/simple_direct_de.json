{
  "schema_version": "1.0",
  "scenario_id": "simple_direct_de",
  "scenario_type": "questionnaire_direct_translation",
  "description": "German-language baseline: ask each SapplyValues item in German using a fresh standalone prompt. Same direct format as simple_direct, with translated instructions, answer options, and question text.",
  "questionnaire_id": "sapplyvalues",
  "language": "de",
  "prompt_builder": "template_messages_v1",
  "messages": [
    {
      "role": "user",
      "template_path": "templates/sapplyvalues_prompt_de.txt"
    }
  ],
  "variables": {
    "question_field": "text_de"
  },
  "response_contract": {
    "type": "json_object",
    "required_fields": ["answer", "answer_score", "reason"],
    "answer_scale": {
      "Stimme überhaupt nicht zu": -1.0,
      "Stimme nicht zu": -0.5,
      "Neutral / Unsicher": 0.0,
      "Stimme zu": 0.5,
      "Stimme voll und ganz zu": 1.0
    }
  }
}
