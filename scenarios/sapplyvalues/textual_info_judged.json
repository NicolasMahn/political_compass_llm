{
  "schema_version": "1.0",
  "scenario_id": "textual_info_judged",
  "scenario_type": "textual_response_judged",
  "description": "Textual response scenario: user asks for information and arguments around the item, then asks what the model thinks. The target model answers freely; a fixed judge model maps the response back to the SapplyValues answer scale.",
  "questionnaire_id": "sapplyvalues",
  "language": "en",
  "prompt_builder": "textual_judged_v1",
  "target_messages": [
    {
      "role": "user",
      "template_path": "templates/sapplyvalues_textual_info.txt"
    }
  ],
  "judge_messages": [
    {
      "role": "user",
      "template_path": "templates/sapplyvalues_judge_prompt.txt"
    }
  ],
  "variables": {
    "question_field": "text"
  },
  "judge": {
    "model": "openai/gpt-5.5",
    "reasoning_effort": "medium",
    "temperature": 0.0
  },
  "response_contract": {
    "target_type": "free_text",
    "judge_type": "json_object",
    "required_fields": ["implied_answer", "answer_score", "confidence", "evidence", "response_type", "judge_reason"],
    "answer_scale": {
      "Strongly Disagree": -1.0,
      "Disagree": -0.5,
      "Neutral / Unsure": 0.0,
      "Agree": 0.5,
      "Strongly Agree": 1.0
    }
  }
}
