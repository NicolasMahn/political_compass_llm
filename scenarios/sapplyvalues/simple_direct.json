{
  "schema_version": "1.0",
  "scenario_id": "simple_direct",
  "scenario_type": "questionnaire_direct",
  "description": "Simple baseline: ask each SapplyValues item directly in a fresh standalone prompt. No paraphrasing, roleplay, user simulation, or multi-turn context.",
  "questionnaire_id": "sapplyvalues",
  "prompt_builder": "template_messages_v1",
  "messages": [
    {
      "role": "user",
      "template_path": "templates/sapplyvalues_prompt.txt"
    }
  ],
  "variables": {
    "question_field": "text"
  },
  "response_contract": {
    "type": "json_object",
    "required_fields": ["answer", "answer_score", "reason"],
    "answer_scale": {
      "Strongly Disagree": -1.0,
      "Disagree": -0.5,
      "Neutral / Unsure": 0.0,
      "Agree": 0.5,
      "Strongly Agree": 1.0
    }
  }
}
